# Скопируйте в .env и заполните. Сам .env в репозиторий не коммитится.

# Токен от @BotFather (обязательно).
BOT_TOKEN=

# ID администраторов через запятую. Узнать свой ID: @userinfobot.
ADMIN_IDS=

DATA_FILE=data/users.json
BROADCAST_DELAY_MS=60

# ---------- Картинки ----------
# Значение: путь к файлу (assets/welcome.png), https-ссылка или file_id Telegram.
# Локальный файл загружается один раз, дальше бот переиспользует file_id.
WELCOME_PHOTO=assets/welcome.png
# Картинка для каждого вопроса. Не задано — берётся QUESTION_PHOTO,
# затем assets/question_N.jpg|png, если такой файл есть.
QUESTION_PHOTO_1=
QUESTION_PHOTO_2=
QUESTION_PHOTO_3=
QUESTION_PHOTO_4=
QUESTION_PHOTO_5=
# Общая картинка для всех вопросов (если отдельные не заданы).
QUESTION_PHOTO=

# ---------- Практика ----------
# Аудиофайл практики (путь, https-ссылка или file_id). Если задан — бот присылает
# аудио прямо в чат и контакты для доставки не нужны.
PRACTICE_AUDIO=
# Ссылка на практику — используется, если PRACTICE_AUDIO не задан.
PRACTICE_URL=

# ---------- Персональные данные (152-ФЗ) ----------
# Реквизиты оператора: ФИО/наименование и ИНН или ОГРНИП.
OPERATOR_NAME=
# Куда писать запросы по персональным данным: e-mail или @логин.
OPERATOR_CONTACT=
# Ссылка на опубликованную политику обработки персональных данных.
POLICY_URL=
# Запрашивать ли номер телефона (кнопка «Поделиться номером»). По умолчанию — нет.
COLLECT_PHONE=false
# Срок хранения профиля в днях с последнего обновления. 0 — без автоудаления.
DATA_RETENTION_DAYS=365

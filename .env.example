# Скопируйте в .env и заполните. Сам .env в репозиторий не коммитится.

# Токен от @BotFather (обязательно).
BOT_TOKEN=

# ID администраторов через запятую. Узнать свой ID: @userinfobot.
ADMIN_IDS=

DATA_FILE=data/users.json
BROADCAST_DELAY_MS=60

# ---------- Режим получения обновлений ----------
# Пусто — long polling (проще всего). Для вебхука укажите https-адрес и секрет.
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_LISTEN=:8080
WEBHOOK_PATH=/telegram/webhook

# ---------- Прокси до Telegram ----------
# Если с сервера api.telegram.org недоступен, бот может ходить через прокси,
# например локальный Xray (см. deploy/xray-from-sub.py): HTTPS_PROXY=http://127.0.0.1:10809
HTTPS_PROXY=

# ---------- Картинки ----------
# Значение: путь к файлу (assets/welcome.jpg), https-ссылка или file_id Telegram.
# Локальный файл загружается один раз, дальше бот переиспользует file_id.
WELCOME_PHOTO=assets/welcome.jpg
# Картинка для каждого вопроса. Не задано — берётся QUESTION_PHOTO,
# затем assets/question_N.jpg|png, если такой файл есть.
QUESTION_PHOTO_1=
QUESTION_PHOTO_2=
QUESTION_PHOTO_3=
QUESTION_PHOTO_4=
QUESTION_PHOTO_5=
# Общая картинка для всех вопросов (если отдельные не заданы).
QUESTION_PHOTO=

# Картинки результата: преобладает ответ 1, 2, 3 и при равенстве баллов.
# Не задано — берутся assets/result_1.jpg|png, result_2, result_3, result_tie.
RESULT_PHOTO_1=
RESULT_PHOTO_2=
RESULT_PHOTO_3=
RESULT_PHOTO_TIE=

# ---------- Практика ----------
# Аудиофайл практики (путь, https-ссылка или file_id). Бот присылает его прямо
# в чат по кнопке практики. Не задано — берётся assets/practice.mp3 (.m4a, .ogg).
PRACTICE_AUDIO=
# Ссылка на практику — используется, если PRACTICE_AUDIO не задан.
PRACTICE_URL=

# ---------- Персональные данные (152-ФЗ) ----------
# Реквизиты оператора: ФИО/наименование и ИНН или ОГРНИП.
OPERATOR_NAME=
# Куда писать запросы по персональным данным: e-mail или @логин.
OPERATOR_CONTACT=
# Ссылка на опубликованную политику обработки персональных данных.
POLICY_URL=
# Запрашивать ли номер телефона (кнопка «Поделиться номером»). По умолчанию — нет.
COLLECT_PHONE=true
# Срок хранения профиля в днях с последнего обновления. 0 — без автоудаления.
DATA_RETENTION_DAYS=365
